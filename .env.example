# ==================================================
# CODEBASE MEMORY - ENVIRONMENT CONFIGURATION
# ==================================================

# 1. Hindsight Configuration (Vectorize.io)
# Your Hindsight API key from Hindsight Cloud
HINDSIGHT_API_KEY=your_hindsight_api_key_here
# Endpoint URL (default is https://api.hindsight.vectorize.io)
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
# Default Memory Bank ID for team memory
HINDSIGHT_BANK_ID=codebase-memory-team-default

# 2. LLM Provider Configuration
# You can use Gemini (recommended) or Groq
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq Alternative (optional)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
